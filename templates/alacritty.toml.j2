{%- set a = theme.terminal.ansi -%}
{%- set names = ["black", "red", "green", "yellow", "blue", "magenta", "cyan", "white"] -%}
# Generated by uqd from {{ theme.name }} ({{ variant }}).
[colors.primary]
background = "{{ theme.colors.bg }}"
foreground = "{{ theme.colors.text }}"

[colors.normal]
{% for n in names -%}
{{ n }} = "{{ a[loop.index0] }}"
{% endfor %}
[colors.bright]
{% for n in names -%}
{{ n }} = "{{ a[loop.index0 + 8] }}"
{% endfor -%}
