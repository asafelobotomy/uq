{%- set c = theme.colors -%}
{%- macro fg(normal, muted, active) -%}
ForegroundNormal={{ normal|rgb }}
ForegroundInactive={{ muted|rgb }}
ForegroundActive={{ active|rgb }}
ForegroundLink={{ active|rgb }}
ForegroundVisited={{ active|rgb }}
ForegroundNegative={{ c.error|rgb }}
ForegroundNeutral={{ c.warning|rgb }}
ForegroundPositive={{ c.success|rgb }}
DecorationFocus={{ c.accent|rgb }}
DecorationHover={{ c.accent|rgb }}
{%- endmacro -%}
# Generated by uqd from {{ theme.name }} ({{ variant }}). A KDE colour scheme: Kirigami and other
# KDE frameworks read their colours from it (uQ Settings loads it as KDE_COLOR_SCHEME_PATH).
[General]
ColorScheme=uQ
Name=uQ {{ theme.name }} ({{ variant }})

[Colors:Window]
BackgroundNormal={{ c.bg|rgb }}
BackgroundAlternate={{ c.surface|rgb }}
{{ fg(c.text, c.text_muted, c.accent) }}

[Colors:View]
BackgroundNormal={{ c.surface|rgb }}
BackgroundAlternate={{ c.surface_alt|rgb }}
{{ fg(c.text, c.text_muted, c.accent) }}

[Colors:Button]
BackgroundNormal={{ c.surface_alt|rgb }}
BackgroundAlternate={{ c.overlay|rgb }}
{{ fg(c.text, c.text_muted, c.accent) }}

[Colors:Header]
BackgroundNormal={{ c.surface|rgb }}
BackgroundAlternate={{ c.surface_alt|rgb }}
{{ fg(c.text, c.text_muted, c.accent) }}

[Colors:Tooltip]
BackgroundNormal={{ c.surface_alt|rgb }}
BackgroundAlternate={{ c.overlay|rgb }}
{{ fg(c.text, c.text_muted, c.accent) }}

[Colors:Complementary]
BackgroundNormal={{ c.surface_alt|rgb }}
BackgroundAlternate={{ c.overlay|rgb }}
{{ fg(c.text, c.text_muted, c.accent) }}

[Colors:Selection]
BackgroundNormal={{ c.accent|rgb }}
BackgroundAlternate={{ c.accent|rgb }}
ForegroundNormal={{ c.accent_text|rgb }}
ForegroundInactive={{ c.accent_text|rgb }}
ForegroundActive={{ c.accent_text|rgb }}
ForegroundLink={{ c.accent_text|rgb }}
ForegroundVisited={{ c.accent_text|rgb }}
ForegroundNegative={{ c.accent_text|rgb }}
ForegroundNeutral={{ c.accent_text|rgb }}
ForegroundPositive={{ c.accent_text|rgb }}
DecorationFocus={{ c.accent|rgb }}
DecorationHover={{ c.accent|rgb }}

[WM]
activeBackground={{ c.surface|rgb }}
activeForeground={{ c.text|rgb }}
inactiveBackground={{ c.bg|rgb }}
inactiveForeground={{ c.text_muted|rgb }}
