{%- set c = theme.colors -%}
/* Generated by uqd from {{ theme.name }} ({{ variant }}). libadwaita named colours. */
@define-color accent_color {{ c.accent }};
@define-color accent_bg_color {{ c.accent }};
@define-color accent_fg_color {{ c.accent_text }};
@define-color destructive_color {{ c.error }};
@define-color destructive_bg_color {{ c.error }};
@define-color success_color {{ c.success }};
@define-color warning_color {{ c.warning }};
@define-color error_color {{ c.error }};
@define-color window_bg_color {{ c.bg }};
@define-color window_fg_color {{ c.text }};
@define-color view_bg_color {{ c.surface }};
@define-color view_fg_color {{ c.text }};
@define-color headerbar_bg_color {{ c.surface_alt }};
@define-color headerbar_fg_color {{ c.text }};
@define-color sidebar_bg_color {{ c.surface }};
@define-color sidebar_fg_color {{ c.text }};
@define-color card_bg_color {{ c.surface }};
@define-color card_fg_color {{ c.text }};
@define-color dialog_bg_color {{ c.surface_alt }};
@define-color dialog_fg_color {{ c.text }};
@define-color popover_bg_color {{ c.surface_alt }};
@define-color popover_fg_color {{ c.text }};
@define-color borders {{ c.border }};
