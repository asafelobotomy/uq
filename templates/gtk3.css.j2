{%- set c = theme.colors -%}
/* Generated by uqd from {{ theme.name }} ({{ variant }}). Adwaita GTK 3 named colours. */
@define-color theme_bg_color {{ c.bg }};
@define-color theme_fg_color {{ c.text }};
@define-color theme_base_color {{ c.surface }};
@define-color theme_text_color {{ c.text }};
@define-color theme_selected_bg_color {{ c.accent }};
@define-color theme_selected_fg_color {{ c.accent_text }};
@define-color insensitive_fg_color {{ c.text_muted }};
@define-color borders {{ c.border }};
@define-color success_color {{ c.success }};
@define-color warning_color {{ c.warning }};
@define-color error_color {{ c.error }};
