{%- set c = theme.colors -%}
[%General]
inherits={{ base }}

[GeneralColors]
window.color={{ c.bg }}
base.color={{ c.surface }}
alt.base.color={{ c.surface_alt }}
button.color={{ c.surface_alt }}
light.color={{ c.overlay }}
mid.color={{ c.border }}
dark.color={{ c.bg }}
highlight.color={{ c.accent }}
inactive.highlight.color={{ c.accent }}
text.color={{ c.text }}
window.text.color={{ c.text }}
button.text.color={{ c.text }}
disabled.text.color={{ c.text_muted }}
tooltip.text.color={{ c.text }}
highlight.text.color={{ c.accent_text }}
link.color={{ c.accent }}
link.visited.color={{ c.accent }}
progress.indicator.text.color={{ c.accent_text }}
