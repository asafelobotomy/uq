{%- set c = theme.colors -%}
{#- `base` only says Kvantum is installed. The look comes from kvantum.svg.j2 and the sections
    below, not from a stock Kvantum theme: inheriting one did nothing, and the built-in grey bevel
    showed through instead. Frame widths equal the corner size in the SVG (`r`, or 4 / 3). -#}
{%- set r = [[theme.ui.radius, 6]|min, 3]|max -%}
[%General]
author=uQ
comment=Generated by uqd from {{ theme.name }} ({{ variant }})
composite=true
x11drag=none
alt_mnemonic=true
left_tabs=false
attach_active_tab=false
group_toolbar_buttons=false
spread_progressbar=true
progressbar_thickness=6
animate_states=true
transient_scrollbar=true
transient_groove=false
scroll_width=10
scroll_min_extent=40
scroll_arrows=false
slider_width=6
slider_handle_width=16
slider_handle_length=16
check_size=16
toolbar_icon_size=16
combo_as_lineedit=true
inline_spin_indicators=true
spread_menuitems=true
menu_shadow_depth=8
tooltip_shadow_depth=6
splitter_width=6
layout_spacing=6
layout_margin=8
button_contents_shift=false
submenu_overlap=0
respect_darkness=true

[GeneralColors]
window.color={{ c.bg }}
base.color={{ c.surface }}
alt.base.color={{ c.surface_alt }}
button.color={{ c.surface_alt }}
light.color={{ c.overlay }}
mid.color={{ c.border }}
dark.color={{ c.bg }}
highlight.color={{ c.accent }}
inactive.highlight.color={{ c.accent }}
text.color={{ c.text }}
window.text.color={{ c.text }}
button.text.color={{ c.text }}
disabled.text.color={{ c.text_muted }}
tooltip.text.color={{ c.text }}
highlight.text.color={{ c.accent_text }}
link.color={{ c.accent }}
link.visited.color={{ c.accent }}
progress.indicator.text.color={{ c.accent_text }}

[Hacks]
respect_darkness=true
transparent_ktitle_label=true

[PanelButtonCommand]
frame=true
frame.element=button
frame.top={{ r }}
frame.bottom={{ r }}
frame.left={{ r }}
frame.right={{ r }}
interior=true
interior.element=button
interior.x.patternsize=-1
interior.y.patternsize=-1
text.normal.color={{ c.text }}
text.focus.color={{ c.text }}
text.press.color={{ c.text }}
text.toggle.color={{ c.accent_text }}
text.shadow=0
text.margin.top=3
text.margin.bottom=3
text.margin.left=8
text.margin.right=8
text.iconspacing=6
indicator.element=arrow
indicator.size=12

[PanelButtonTool]
inherits=PanelButtonCommand
interior.element=tbutton
frame.element=tbutton
text.toggle.color={{ c.text }}
text.margin.left=4
text.margin.right=4

[ToolbarButton]
inherits=PanelButtonTool

[Dock]
inherits=PanelButtonCommand
frame=true
interior=true
frame.element=common
interior.element=common

[DockTitle]
inherits=PanelButtonCommand
frame=false
interior=false

[IndicatorSpinBox]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.element=arrow
indicator.size=10

[RadioButton]
inherits=PanelButtonCommand
frame=false
interior.element=radio
text.toggle.color={{ c.text }}
text.margin.left=6
text.margin.right=2

[CheckBox]
inherits=PanelButtonCommand
frame=false
interior.element=checkbox
text.toggle.color={{ c.text }}
text.margin.left=6
text.margin.right=2

[GenericFrame]
inherits=PanelButtonCommand
frame=true
interior=false
frame.element=common

[LineEdit]
inherits=PanelButtonCommand
frame.element=lineedit
interior.element=lineedit
text.margin.top=2
text.margin.bottom=2
text.margin.left=4
text.margin.right=4

[DropDownButton]
inherits=PanelButtonCommand
indicator.element=arrow-down

[IndicatorArrow]
indicator.element=arrow

[ToolboxTab]
inherits=PanelButtonCommand

[Tab]
inherits=PanelButtonCommand
frame.element=tab
interior.element=tab
indicator.element=tab
text.toggle.color={{ c.accent_text }}
text.margin.top=2
text.margin.bottom=2
min_width=+4
min_height=+4

[TabFrame]
inherits=GenericFrame
frame.element=tabframe

[TabBarFrame]
inherits=GenericFrame
frame=false

[TreeExpander]
inherits=PanelButtonCommand
frame=false
interior=false

[HeaderSection]
inherits=PanelButtonCommand
frame=false
interior.element=tbutton
interior=true

[SizeGrip]
inherits=PanelButtonCommand
frame=false
interior=false

[Toolbar]
inherits=PanelButtonCommand
frame=false
interior=false

[Slider]
inherits=PanelButtonCommand
frame.element=slider
interior.element=slider
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3

[SliderCursor]
inherits=PanelButtonCommand
frame=false
interior.element=slidercursor

[Progressbar]
inherits=PanelButtonCommand
frame.element=progress
interior.element=progress
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
text.focus.color={{ c.text }}
text.press.color={{ c.text }}
text.toggle.color={{ c.text }}

[ProgressbarContents]
inherits=PanelButtonCommand
frame=true
frame.element=progress-pattern
interior.element=progress-pattern
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3

[ItemView]
inherits=PanelButtonCommand
frame.element=itemview
interior.element=itemview
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4
text.toggle.color={{ c.accent_text }}
text.press.color={{ c.accent_text }}
text.margin.top=2
text.margin.bottom=2

[Splitter]
inherits=PanelButtonCommand
frame=false
interior=false

[Scrollbar]
inherits=PanelButtonCommand
frame=false
interior=false

[ScrollbarSlider]
inherits=PanelButtonCommand
frame.element=scrollbarslider
interior.element=scrollbarslider
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4

[ScrollbarGroove]
inherits=PanelButtonCommand
frame.element=scrollbargroove
interior.element=scrollbargroove
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4

[ScrollbarTransientSlider]
inherits=ScrollbarSlider

[MenuItem]
inherits=PanelButtonCommand
frame=true
frame.element=menuitem
interior.element=menuitem
indicator.element=menuitem
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4
text.focus.color={{ c.accent_text }}
text.press.color={{ c.accent_text }}
text.toggle.color={{ c.accent_text }}
text.margin.top=2
text.margin.bottom=2

[MenuBarItem]
inherits=PanelButtonCommand
frame.element=menubaritem
interior.element=menubaritem
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4
text.focus.color={{ c.text }}
text.press.color={{ c.accent_text }}
text.toggle.color={{ c.accent_text }}

[ComboBox]
inherits=PanelButtonCommand

[Menu]
inherits=PanelButtonCommand
frame.element=menu
interior.element=menu
text.margin.left=0
text.margin.right=0

[GroupBox]
inherits=GenericFrame
frame.element=group
text.margin.left=0
text.margin.right=0

[TitleBar]
inherits=PanelButtonCommand
frame=false
interior=false

[ToolTip]
inherits=PanelButtonCommand
frame.element=menu
interior.element=menu
