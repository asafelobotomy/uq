# Generated by uqd from {{ theme.name }} ({{ variant }}).
[colors]
background={{ theme.colors.bg|bare }}
foreground={{ theme.colors.text|bare }}
{% for c in theme.terminal.ansi[:8] -%}
regular{{ loop.index0 }}={{ c|bare }}
{% endfor -%}
{% for c in theme.terminal.ansi[8:] -%}
bright{{ loop.index0 }}={{ c|bare }}
{% endfor -%}
selection-background={{ theme.colors.accent|bare }}
selection-foreground={{ theme.colors.accent_text|bare }}
