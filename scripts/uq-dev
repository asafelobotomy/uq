#!/usr/bin/env bash
# uq-dev: use the installed uQ apps and develop them on the same machine (docs/developing.md).
#
#   uq-dev session [--no-build]            nested uQ desktop running this checkout's uqd and shell
#   uq-dev run <repo> [--real-config] [-- cmd...]
#                                          run an app from its checkout with throwaway config dirs
#   uq-dev promote <repo> [makepkg args]   build the checkout's HEAD as a package and install it
#   uq-dev rollback <package>              put back the last build that did not come from promote
#   uq-dev status                          list installed packages that came from promote
#
# Checkouts live in $UQ_DEV_PROJECTS (default ~/Projects), one folder per repo, named as on GitHub.
# Throwaway state lives in $UQ_DEV_HOME (default ~/.local/share/uq-dev).
set -euo pipefail

projects=${UQ_DEV_PROJECTS:-$HOME/Projects}
devhome=${UQ_DEV_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/uq-dev}
# Every package promote builds is listed here ("name version commit"); rollback and status read it.
ledger=$devhome/promoted

die() { echo "uq-dev: $*" >&2; exit 1; }
note() { echo "uq-dev: $*" >&2; }

usage() { sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; }

repo_dir() {
    local d=$projects/$1
    [ -d "$d/.git" ] || die "no checkout at $d (clone it, or set UQ_DEV_PROJECTS)"
    printf '%s\n' "$d"
}

# ---------------------------------------------------------------------------------------------
# run: a plain app from its checkout, next to the installed copy

cmd_run() {
    local repo=${1:-} real=0
    [ -n "$repo" ] || die "usage: uq-dev run <repo> [--real-config] [-- cmd...]"
    shift
    if [ "${1:-}" = --real-config ]; then real=1; shift; fi
    [ "${1:-}" = -- ] && shift
    local dir; dir=$(repo_dir "$repo")
    local cmd=("$@")
    if [ ${#cmd[@]} = 0 ]; then
        if [ -f "$dir/Cargo.toml" ]; then cmd=(cargo run)
        elif [ -f "$dir/pyproject.toml" ]; then cmd=(uv run "$repo")
        else die "don't know how to run $repo; pass the command after --"
        fi
    fi
    cd "$dir"
    if [ "$real" = 1 ]; then
        exec "${cmd[@]}"
    fi
    local sb=$devhome/run/$repo
    mkdir -p "$sb/config" "$sb/state" "$sb/cache"
    note "config, state and cache for this run are in $sb (--real-config uses your own)"
    XDG_CONFIG_HOME=$sb/config XDG_STATE_HOME=$sb/state XDG_CACHE_HOME=$sb/cache exec "${cmd[@]}"
}

# ---------------------------------------------------------------------------------------------
# session: Hyprland as a window inside the real desktop, on a private D-Bus bus and a private
# runtime dir, with sandboxed config and state, running this checkout's uqd and shell

cmd_session() {
    local build=1
    [ "${1:-}" = --no-build ] && build=0
    local uq; uq=$(repo_dir uq)
    [ -n "${WAYLAND_DISPLAY:-}" ] || die "run this from inside a Wayland session (it opens as a window)"
    [ -n "${XDG_RUNTIME_DIR:-}" ] || die "XDG_RUNTIME_DIR is not set"
    for bin in Hyprland qs dbus-run-session; do
        command -v "$bin" >/dev/null 2>&1 || die "$bin is not installed"
    done
    if [ "$build" = 1 ]; then
        (cd "$uq" && cargo build -p uqd -p uqctl) || die "cargo build failed"
    fi
    for bin in uqd uqctl; do
        [ -x "$uq/target/debug/$bin" ] || die "no $uq/target/debug/$bin (drop --no-build)"
    done

    local sb=$devhome/session
    mkdir -p "$sb/config/hypr/uq" "$sb/state" "$sb/share" "$sb/bin" "$sb/log"
    # uqd reads base.lua, themes and templates from UQ_DATA_DIR in the installed layout.
    ln -sfn "$uq/config/hypr" "$sb/share/hypr"
    ln -sfn "$uq/themes" "$sb/share/themes"
    ln -sfn "$uq/templates" "$sb/share/templates"
    # Hyprland refuses a config whose require()s are missing; uqd fills generated.lua.
    touch "$sb/config/hypr/uq/generated.lua" "$sb/config/hypr/uq/user.lua"

    # A last line of defence: anything in the session that asks the real user manager to restart,
    # stop or start uQ's own units (the lock bind, an old base.lua) is refused, not obeyed.
    cat >"$sb/bin/systemctl" <<'SH'
#!/bin/sh
for a in "$@"; do
    case "$a" in
        uqd|uqd.service|uq-shell|uq-shell.service|uq-lock|uq-lock.service|scdr-session|scdr-session.service)
            case " $* " in *" is-active "*|*" is-enabled "*|*" status "*) exit 3 ;; esac
            echo "uq-dev: refused 'systemctl $*' inside the dev session" >&2
            exit 0 ;;
    esac
done
exec /usr/bin/systemctl "$@"
SH
    chmod 755 "$sb/bin/systemctl"

    # Unix socket paths stay under 108 bytes, so the runtime dir is short and in /tmp.
    local rt; rt=$(mktemp -d /tmp/uqdev.XXXXXX)
    chmod 700 "$rt"
    local orig_rt=$XDG_RUNTIME_DIR
    # Shared with the real session on purpose: audio, and the user manager (app scopes).
    # Not shared: the session bus, notifd, hauler and emobie sockets, Hyprland's own dir.
    for f in pipewire-0 pipewire-0-manager pulse systemd; do
        [ -e "$orig_rt/$f" ] && ln -s "$orig_rt/$f" "$rt/$f"
    done
    local parent=$WAYLAND_DISPLAY
    case "$parent" in /*) ;; *) parent=$orig_rt/$parent ;; esac

    local notifi=$projects/noti-fi/notifd
    {
        printf 'require([[%s]])\n' "$uq/config/hypr/base.lua"
        printf 'require("./uq/generated.lua")\nrequire("./uq/user.lua")\n'
        printf '%s\n' '-- uq-dev session: the checkout'"'"'s daemons, started here instead of by systemd.'
        printf 'hl.on("hyprland.start", function()\n'
        printf '    hl.exec_cmd([[exec %q >>%q 2>&1]])\n' "$uq/target/debug/uqd" "$sb/log/uqd.log"
        printf '    hl.exec_cmd([[exec qs -p %q >>%q 2>&1]])\n' "$uq/shell" "$sb/log/shell.log"
        if [ -f "$notifi/shell.qml" ]; then
            printf '    hl.exec_cmd([[exec qs -p %q >>%q 2>&1]])\n' "$notifi" "$sb/log/notifd.log"
        fi
        printf 'end)\n'
    } >"$sb/config/hypr/hyprland.lua"

    note "starting a nested uQ from $uq"
    note "logs: $sb/log; config and state: $sb; close the window or SUPER+SHIFT+M inside it to quit"
    note "your real desktop keeps SUPER shortcuts while it has them; click into the window first"
    local status=0
    env -u HYPRLAND_INSTANCE_SIGNATURE -u DISPLAY \
        UQ_DEV_SESSION=1 \
        XDG_RUNTIME_DIR="$rt" WAYLAND_DISPLAY="$parent" \
        XDG_CONFIG_HOME="$sb/config" XDG_STATE_HOME="$sb/state" UQ_DATA_DIR="$sb/share" \
        PATH="$sb/bin:$uq/target/debug:$PATH" \
        dbus-run-session -- Hyprland -c "$sb/config/hypr/hyprland.lua" >"$sb/log/hyprland.log" 2>&1 || status=$?
    rm -rf "$rt"
    [ "$status" = 0 ] || note "Hyprland exited with $status; see $sb/log/hyprland.log"
    return "$status"
}

# ---------------------------------------------------------------------------------------------
# promote: build HEAD as the package the AUR ships, and install it

# repo -> "release <PKGBUILD> <source dir in the tarball>" (the PKGBUILD downloads a release
# tarball; promote packs HEAD the same way) or "local <PKGBUILD>" (it already builds the checkout).
# shellcheck disable=SC2016 # the templates expand inside the PKGBUILD, not here
pkgbuild_for() {
    case "$1" in
        uq) echo 'release packaging/uq/PKGBUILD $pkgname-$_tag' ;;
        noti-fi) echo 'release packaging/PKGBUILD $pkgname-$pkgver' ;;
        crumbs) echo 'release packaging/aur/crum-bs/PKGBUILD $_pkgname-$pkgver' ;;
        emobie) echo 'release packaging/arch/PKGBUILD $pkgname-$pkgver' ;;
        oysterAV) echo 'release packaging/arch/PKGBUILD oysterAV-$pkgver' ;;
        scdr) echo 'local packaging/arch/PKGBUILD' ;;
        appofholding) echo 'local packaging/arch/PKGBUILD' ;;
        hauler) echo 'local dist/arch/PKGBUILD' ;;
        XZram) echo 'local PKGBUILD' ;;
        *) return 1 ;;
    esac
}

# Rewrite pkgrel to <pkgrel>.<commit count>: newer than the AUR build of the same version (so an
# update does not undo the promote), older than the AUR's next pkgrel or version.
mark_pkgbuild() { # mark_pkgbuild <in> <out> <rev count>
    sed -E -e "s/^pkgrel=([0-9]+).*/pkgrel=\1.$3/" "$1" >"$2"
    grep -q "^pkgrel=[0-9]*\.$3\$" "$2" || die "could not rewrite pkgrel in $1"
}

is_promoted() { [ -f "$ledger" ] && grep -q "^$1 $2 " "$ledger"; }

# Packages makepkg wrote to PKGDEST since <stamp> go into the ledger.
record_built() { # record_built <stamp> <sha>
    local f name ver
    while IFS= read -r f; do
        read -r name ver < <(pacman -Qp "$f" 2>/dev/null) || continue
        is_promoted "$name" "$ver" || echo "$name $ver $2" >>"$ledger"
    done < <(find "$PKGDEST" -maxdepth 1 -newer "$1" -name '*.pkg.tar.*' ! -name '*.sig')
}

# Replace the source and checksum arrays (one line or several) with the local tarball.
swap_sources() { # swap_sources <file> < PKGBUILD > PKGBUILD
    awk -v file="$1" '
        skip { if ($0 ~ /\)/) skip = 0; next }
        /^source(_x86_64)?=\(/ || /^(sha256|sha512|b2|md5)sums(_x86_64)?=\(/ {
            if ($0 ~ /^source=/) print "source=(\"" file "\")"
            if ($0 ~ /^sha256sums=/) print "sha256sums=(SKIP)"
            if ($0 !~ /\)/) skip = 1
            next
        }
        { print }'
}

cmd_promote() {
    local repo=${1:-}
    [ -n "$repo" ] || die "usage: uq-dev promote <repo> [makepkg args]"
    shift
    local dir; dir=$(repo_dir "$repo")
    local spec; spec=$(pkgbuild_for "$repo") || die "$repo has no package to promote; use 'uq-dev run $repo'"
    local kind pkgbuild prefix_tpl
    read -r kind pkgbuild prefix_tpl <<<"$spec"
    [ -f "$dir/$pkgbuild" ] || die "$dir/$pkgbuild is missing"
    [ -z "$(git -C "$dir" status --porcelain --untracked-files=no)" ] ||
        note "uncommitted changes are not included: promote builds HEAD"
    local count sha
    count=$(git -C "$dir" rev-list --count HEAD)
    sha=$(git -C "$dir" rev-parse --short HEAD)
    export PKGDEST=${PKGDEST:-$devhome/pkg}
    mkdir -p "$PKGDEST"
    local args=("$@")
    [ ${#args[@]} = 0 ] && args=(-si)
    local stamp; stamp=$(mktemp "${TMPDIR:-/tmp}/uq-dev-stamp.XXXXXX")

    if [ "$kind" = local ]; then
        # These PKGBUILDs find the checkout through $startdir, so they must run where they are.
        local pdir; pdir=$(dirname "$dir/$pkgbuild")
        local tmp=$pdir/.uq-dev.PKGBUILD
        mark_pkgbuild "$dir/$pkgbuild" "$tmp" "$count"
        local build; build=$(mktemp -d "${TMPDIR:-/tmp}/uq-dev-build.XXXXXX")
        local st=0
        (cd "$pdir" && BUILDDIR=$build makepkg -p .uq-dev.PKGBUILD "${args[@]}") || st=$?
        rm -rf "$tmp" "$build"
        record_built "$stamp" "$sha"
        rm -f "$stamp"
        return "$st"
    fi

    local work; work=$(mktemp -d "${TMPDIR:-/tmp}/uq-dev-build.XXXXXX")
    trap 'rm -rf "$work"' RETURN
    # The tarball name and top folder come from the PKGBUILD itself.
    local names
    names=$(cd "$dir/$(dirname "$pkgbuild")" && bash -c '
        set -e; source "$1" >/dev/null
        s=${source[0]}; case "$s" in *::*) f=${s%%::*} ;; *) f=${s##*/} ;; esac
        eval "p=\"$2\""; printf "%s %s\n" "$f" "$p"' _ "$dir/$pkgbuild" "$prefix_tpl")
    local file prefix
    read -r file prefix <<<"$names"
    if [ -z "$file" ] || [ -z "$prefix" ]; then die "could not read the source name from $pkgbuild"; fi
    git -C "$dir" archive --format=tar.gz --prefix="$prefix/" -o "$work/$file" HEAD
    mark_pkgbuild "$dir/$pkgbuild" "$work/PKGBUILD" "$count"
    # The local file replaces the release URL; it has no published checksum.
    swap_sources "$file" <"$work/PKGBUILD" >"$work/PKGBUILD.new"
    mv "$work/PKGBUILD.new" "$work/PKGBUILD"
    grep -q "^source=(\"$file\")\$" "$work/PKGBUILD" || die "could not swap the source in $pkgbuild"
    local st=0
    (cd "$work" && makepkg "${args[@]}") || st=$?
    record_built "$stamp" "$sha"
    rm -f "$stamp"
    return "$st"
}

# ---------------------------------------------------------------------------------------------
# rollback / status

cmd_status() {
    local any=0 name ver sha
    if [ -f "$ledger" ]; then
        while read -r name ver sha; do
            [ "$(pacman -Q "$name" 2>/dev/null)" = "$name $ver" ] || continue
            echo "$name $ver  (promoted from commit $sha)"
            any=1
        done <"$ledger"
    fi
    [ "$any" = 1 ] || echo "no promoted packages installed"
}

cmd_rollback() {
    local pkg=${1:-}
    [ -n "$pkg" ] || die "usage: uq-dev rollback <package>"
    local cur; cur=$(pacman -Q "$pkg" 2>/dev/null) || die "$pkg is not installed"
    is_promoted "$pkg" "${cur#* }" || die "$pkg ${cur#* } did not come from 'uq-dev promote'; nothing to roll back"
    # Builds pacman or an AUR helper kept. Newest first; skip promoted ones.
    local best="" bestver="" f name ver
    for f in /var/cache/pacman/pkg/"$pkg"-*.pkg.tar.* \
             "$HOME"/.cache/paru/clone/"$pkg"/*.pkg.tar.* \
             "$HOME"/.cache/yay/"$pkg"/*.pkg.tar.*; do
        [ -f "$f" ] || continue
        case "$f" in *.sig) continue ;; esac
        read -r name ver < <(pacman -Qp "$f" 2>/dev/null) || continue
        [ "$name" = "$pkg" ] || continue
        is_promoted "$name" "$ver" && continue
        if [ -z "$best" ] || [ "$(vercmp "$ver" "$bestver")" -gt 0 ]; then best=$f; bestver=$ver; fi
    done
    if [ -n "$best" ]; then
        note "reinstalling $pkg $bestver from $best"
        sudo pacman -U "$best"
        return
    fi
    local helper
    for helper in paru yay; do
        if command -v "$helper" >/dev/null 2>&1; then
            note "no earlier build of $pkg is cached; reinstalling it from the AUR with $helper"
            "$helper" -S "$pkg"
            return
        fi
    done
    die "no earlier build of $pkg is cached and no AUR helper is installed"
}

case "${1:-}" in
    session) shift; cmd_session "$@" ;;
    run) shift; cmd_run "$@" ;;
    promote) shift; cmd_promote "$@" ;;
    rollback) shift; cmd_rollback "$@" ;;
    status) shift; cmd_status "$@" ;;
    -h|--help|help|"") usage ;;
    *) usage >&2; exit 2 ;;
esac
