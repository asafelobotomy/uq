#%PAM-1.0
# uQ's login screen itself: the session greetd runs as the `greeter` user to show it. Installed to
# /etc/pam.d/uq-greeter; /etc/uq/greetd.toml names it ([default_session] service).
#
# greetd's stack without the keyring. The greeter is not a person logging in: it has no password
# to unlock a keyring with and no home to keep one in, so pam_gnome_keyring here only started a
# keyring daemon for `greeter` that failed to create /.local/share/keyrings. The sessions people
# log in to use /etc/pam.d/uq-greetd, which keeps the keyring.
auth       required     pam_securetty.so
auth       requisite    pam_nologin.so
auth       include      system-local-login
account    include      system-local-login
session    include      system-local-login
