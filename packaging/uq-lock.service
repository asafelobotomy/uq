[Unit]
Description=uQ lock screen (Quickshell)
Documentation=https://github.com/asafelobotomy/uq
PartOf=graphical-session.target
After=graphical-session.target
StartLimitIntervalSec=0

[Service]
# A session component, not an app: user services default to app.slice, where
# priority daemons such as scdr treat it as an app (and demote it under load).
Slice=session.slice
ExecCondition=/bin/sh -c 'test -n "$HYPRLAND_INSTANCE_SIGNATURE" && test -S "$XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket.sock"'
# Runs `qs -p /usr/share/uq/lock` (exec'd: qs is the main PID) with the PAM relay lines filtered
# out of its stdout and stderr.
# QS_ICON_THEME: the icon theme uqd renders from the theme (%S is ~/.local/state). The session
# runs Qt through qt6ct, which has no icon theme of its own; without it the icons go blank.
# Optional (-): a first start before uqd has rendered falls back to Qt's default lookup.
EnvironmentFile=-%S/uq/theme/shell.env
ExecStart=/usr/lib/uq/uq-lock-run
# A crash or kill -9 brings the lock back (Hyprland keeps the session locked meanwhile); the only
# clean exit is after a successful unlock, so exit 0 is not restarted.
Restart=always
RestartPreventExitStatus=0
RestartSec=1
# The lock starts no apps, so the whole cgroup goes with it: the wrapper's grep and any PAM
# subprocess left behind by a crash never outlive the unit.
KillMode=control-group
