#!/bin/bash
# uq-lock.service's ExecStart. Quickshell's PAM subprocess writes every PAM prompt and message
# ("quickshell.service.pam.subprocess: Relaying pam message: ...") straight to qs's stdout and
# stderr, past Quickshell's logger: --log-rules and QT_LOGGING_RULES don't silence it (checked with
# Quickshell 0.3.1/0.3.2). So both streams go through one grep that drops those lines before they
# reach the journal (LogFilterPatterns= only works in system services).
# exec keeps qs as the unit's main PID with its own exit status, so RestartPreventExitStatus=0 still
# means "unlocked". The grep ends on EOF once qs and its children are gone; the unit's
# KillMode=control-group stops it with the unit, so nothing outlives the lock.
# UQ_LOCK_QS replaces the qs binary for tests/shell/lock_wrapper.sh only.
exec "${UQ_LOCK_QS:-/usr/bin/qs}" -p /usr/share/uq/lock > >(grep --line-buffered -v 'quickshell\.service\.pam') 2>&1
