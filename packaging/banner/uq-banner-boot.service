[Unit]
Description=uQ boot banner
DefaultDependencies=no
After=systemd-vconsole-setup.service
Before=sysinit.target
ConditionPathExists=/dev/console
# Settings → Login screen → Startup banner creates this file to turn the banner off.
ConditionPathExists=!/etc/uq/banner-off

[Service]
Type=oneshot
ExecStart=/usr/lib/uq/uq-banner boot
TimeoutSec=5

[Install]
WantedBy=sysinit.target
