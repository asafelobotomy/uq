[Unit]
Description=uQ shutdown banner
DefaultDependencies=no
Before=shutdown.target
ConditionPathExists=/dev/console
# Settings → Login screen → Startup banner creates this file to turn the banner off.
ConditionPathExists=!/etc/uq/banner-off

[Service]
Type=oneshot
ExecStart=/usr/lib/uq/uq-banner shutdown
TimeoutSec=5

[Install]
WantedBy=poweroff.target reboot.target halt.target kexec.target
