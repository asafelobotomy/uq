# A uQ theme. Import it on the Appearance page of uQ Settings, or with
# `uqctl theme import <file>`.
format = 1
id = "dracula"
name = "Dracula"

[dark.colors]
bg = "#282a36"
surface = "#343641"
surface_alt = "#3f414b"
overlay = "#52535c"
text = "#f8f8f2"
text_muted = "#bababa"
accent = "#bd93f9"
accent_text = "#282a36"
border = "#66686e"
success = "#50fa7b"
warning = "#f1fa8c"
error = "#ff5555"

[dark.ui]
radius = 10
gap_in = 5
gap_out = 12
border_width = 2

[dark.fonts]
ui = "Inter"
mono = "JetBrains Mono"
size = 11

[dark.icons]
theme = "Papirus-Dark"
cursor_theme = "Bibata-Modern-Classic"
cursor_size = 24

[dark.terminal]
ansi = ["#21222c", "#ff5555", "#50fa7b", "#f1fa8c", "#bd93f9", "#ff79c6", "#8be9fd", "#f8f8f2", "#6272a4", "#ff6e6e", "#69ff94", "#ffffa5", "#d6acff", "#ff92df", "#a4ffff", "#ffffff"]

[light.colors]
bg = "#fffbeb"
surface = "#f2eedf"
surface_alt = "#e6e3d5"
overlay = "#d2cfc2"
text = "#1f1f1f"
text_muted = "#62615c"
accent = "#644ac9"
accent_text = "#fffbeb"
border = "#bcb9ae"
success = "#14710a"
warning = "#846e15"
error = "#cb3a2a"

[light.ui]
radius = 10
gap_in = 5
gap_out = 12
border_width = 2

[light.fonts]
ui = "Inter"
mono = "JetBrains Mono"
size = 11

[light.icons]
theme = "Papirus-Light"
cursor_theme = "Bibata-Modern-Ice"
cursor_size = 24

[light.terminal]
ansi = ["#1f1f1f", "#cb3a2a", "#14710a", "#846e15", "#644ac9", "#a3144d", "#036a96", "#fffbeb", "#6c664b", "#d74c3d", "#198d0c", "#9e841a", "#7862d0", "#bf185a", "#047fb4", "#ffffff"]
