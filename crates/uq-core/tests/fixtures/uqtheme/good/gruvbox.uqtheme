# A uQ theme. Import it on the Appearance page of uQ Settings, or with
# `uqctl theme import <file>`.
format = 1
id = "gruvbox"
name = "Gruvbox"

[dark.colors]
bg = "#282828"
surface = "#343330"
surface_alt = "#3d3c37"
overlay = "#4f4c44"
text = "#ebdbb2"
text_muted = "#b0a589"
accent = "#d79921"
accent_text = "#282828"
border = "#625e51"
success = "#98971a"
warning = "#d79921"
error = "#cc241d"

[dark.ui]
radius = 10
gap_in = 5
gap_out = 12
border_width = 2

[dark.fonts]
ui = "Inter"
mono = "JetBrains Mono"
size = 11

[dark.icons]
theme = "Papirus-Dark"
cursor_theme = "Bibata-Modern-Classic"
cursor_size = 24

[dark.terminal]
ansi = ["#282828", "#cc241d", "#98971a", "#d79921", "#458588", "#b16286", "#689d6a", "#a89984", "#928374", "#fb4934", "#b8bb26", "#fabd2f", "#83a598", "#d3869b", "#8ec07c", "#ebdbb2"]

[light.colors]
bg = "#fbf1c7"
surface = "#f0e6be"
surface_alt = "#e6ddb7"
overlay = "#d5ccaa"
text = "#3c3836"
text_muted = "#6a6559"
accent = "#946110"
accent_text = "#fbf1c7"
border = "#c2ba9c"
success = "#79740e"
warning = "#b57614"
error = "#9d0006"

[light.ui]
radius = 10
gap_in = 5
gap_out = 12
border_width = 2

[light.fonts]
ui = "Inter"
mono = "JetBrains Mono"
size = 11

[light.icons]
theme = "Papirus-Light"
cursor_theme = "Bibata-Modern-Ice"
cursor_size = 24

[light.terminal]
ansi = ["#fbf1c7", "#cc241d", "#98971a", "#d79921", "#458588", "#b16286", "#689d6a", "#7c6f64", "#928374", "#9d0006", "#79740e", "#b57614", "#076678", "#8f3f71", "#427b58", "#3c3836"]
