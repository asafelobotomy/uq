# A uQ theme. Import it on the Appearance page of uQ Settings, or with
# `uqctl theme import <file>`.
format = 1
id = "rosewood"
name = "Rosewood"

[dark.colors]
bg = "#2a1d1f"
surface = "#36282a"
surface_alt = "#403234"
overlay = "#514345"
text = "#efdcdc"
text_muted = "#b4a3a3"
accent = "#d4737f"
accent_text = "#2a1d1f"
border = "#655658"
success = "#a3b87a"
warning = "#e0b073"
error = "#e5737f"

[dark.ui]
radius = 10
gap_in = 5
gap_out = 12
border_width = 2

[dark.fonts]
ui = "Inter"
mono = "JetBrains Mono"
size = 11

[dark.icons]
theme = "Papirus-Dark"
cursor_theme = "Bibata-Modern-Classic"
cursor_size = 24

[dark.terminal]
ansi = ["#2a1d1f", "#e5737f", "#a3b87a", "#e0b073", "#8aa3c8", "#d4737f", "#86b8b0", "#b4a3a3", "#514345", "#ec969f", "#baca9b", "#e8c496", "#a7bad6", "#df969f", "#a4cac4", "#efdcdc"]

[light.colors]
bg = "#fbf3f2"
surface = "#efe6e6"
surface_alt = "#e6dcdc"
overlay = "#d4c9c9"
text = "#3a2226"
text_muted = "#746163"
accent = "#a23b4b"
accent_text = "#fbf3f2"
border = "#c1b4b5"
success = "#4f6b2a"
warning = "#875a14"
error = "#a23b4b"

[light.ui]
radius = 10
gap_in = 5
gap_out = 12
border_width = 2

[light.fonts]
ui = "Inter"
mono = "JetBrains Mono"
size = 11

[light.icons]
theme = "Papirus-Light"
cursor_theme = "Bibata-Modern-Ice"
cursor_size = 24

[light.terminal]
ansi = ["#3a2226", "#a23b4b", "#4f6b2a", "#875a14", "#3d5a8a", "#8f3a6a", "#2f6e66", "#fbf3f2", "#d4c9c9", "#7a2c38", "#3b5020", "#65440f", "#2e4468", "#6b2c50", "#23524c", "#3a2226"]
