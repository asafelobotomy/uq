# A uQ theme. Import it on the Appearance page of uQ Settings, or with
# `uqctl theme import <file>`.
format = 1
id = "velvet"
name = "Velvet"

[dark.colors]
bg = "#1f1a2b"
surface = "#2b2637"
surface_alt = "#353042"
overlay = "#474154"
text = "#e6defa"
text_muted = "#aaa3bc"
accent = "#b48ead"
accent_text = "#1f1a2b"
border = "#5b5569"
success = "#9cc48a"
warning = "#e3c07a"
error = "#e07a8f"

[dark.ui]
radius = 10
gap_in = 5
gap_out = 12
border_width = 2

[dark.fonts]
ui = "Inter"
mono = "JetBrains Mono"
size = 11

[dark.icons]
theme = "Papirus-Dark"
cursor_theme = "Bibata-Modern-Classic"
cursor_size = 24

[dark.terminal]
ansi = ["#1f1a2b", "#e07a8f", "#9cc48a", "#e3c07a", "#8fa8e8", "#b48ead", "#7fc8d0", "#aaa3bc", "#474154", "#e89bab", "#b5d3a7", "#ead09b", "#abbeee", "#c7aac2", "#9fd6dc", "#e6defa"]

[light.colors]
bg = "#f7f3fc"
surface = "#ebe6f0"
surface_alt = "#e0dce6"
overlay = "#cec9d5"
text = "#2a2238"
text_muted = "#686173"
accent = "#7a4f8f"
accent_text = "#f7f3fc"
border = "#bab4c1"
success = "#4a7a35"
warning = "#866112"
error = "#a83250"

[light.ui]
radius = 10
gap_in = 5
gap_out = 12
border_width = 2

[light.fonts]
ui = "Inter"
mono = "JetBrains Mono"
size = 11

[light.icons]
theme = "Papirus-Light"
cursor_theme = "Bibata-Modern-Ice"
cursor_size = 24

[light.terminal]
ansi = ["#2a2238", "#a83250", "#4a7a35", "#866112", "#3e58a8", "#7a4f8f", "#1f6f7a", "#f7f3fc", "#cec9d5", "#7e263c", "#385c28", "#64490e", "#2e427e", "#5c3b6b", "#17535c", "#2a2238"]
